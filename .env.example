# NiyamSetu — environment configuration EXAMPLE
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed
# with placeholders only. Never put a real password in this file.
#
#   cp .env.example .env
#
# Either set the complete URL:
# NIYAMSETU_DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/niyamsetu
#
# ...or set the parts and let the code assemble it (the password is
# percent-encoded for you, so '@' and '/' in a password are safe):
NIYAMSETU_DB_HOST=localhost
NIYAMSETU_DB_PORT=5432
NIYAMSETU_DB_NAME=niyamsetu
NIYAMSETU_DB_USER=postgres
NIYAMSETU_DB_PASSWORD=replace-me

# The throwaway database the tests may create, truncate and drop.
# MUST be a different database from the one above, and its name MUST contain
# 'test' — backend/app/db/config.py refuses to run destructive tests otherwise.
# Leave unset and the database tests skip themselves rather than guessing.
NIYAMSETU_TEST_DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/niyamsetu_test

# --- API settings (all optional; defaults shown) ---
# Maximum accepted upload size for POST /api/documents/ingest, in bytes.
# Default 26214400 (25 MB).
NIYAMSETU_MAX_UPLOAD_BYTES=26214400

# Where ingestion writes its JSON artefacts and keeps source PDFs. Both are
# git-ignored. Override them to point a test or a sandbox somewhere harmless.
NIYAMSETU_PROCESSED_DIR=data/processed
NIYAMSETU_RAW_DIR=data/raw

# Set to 0 to disable /docs, /redoc and /openapi.json. On by default for
# development; a deployment need not advertise its surface.
NIYAMSETU_DOCS=1

# --- Ask (RAG) -------------------------------------------------------------
# Answer generation is OFF by default. With nothing set here, Ask still works:
# it retrieves the matching clauses and assembles an answer verbatim out of
# them, labelled in the UI as "assembled from the source text". It never
# invents prose and never claims a model wrote it.
#
# To turn on generated answers, pick a provider and give it a key. Any endpoint
# speaking the OpenAI /chat/completions shape works, so this one setting covers
# OpenAI, Groq, Together, OpenRouter, DeepSeek, Mistral, Azure OpenAI, LM Studio
# and vLLM. No vendor SDK is installed; the calls go over httpx, which the
# backend already pins.
#
#   openai | groq | together | openrouter | deepseek | mistral
#       -> needs NIYAMSETU_RAG_LLM_API_KEY
#   ollama        -> a local daemon, no key (ollama serve; ollama pull llama3.1)
#   openai_compatible -> any local server; set NIYAMSETU_RAG_LLM_BASE_URL
#   auto          -> Ollama if it answers, else the key below if one is set
#   none          -> no generation (the default)
#
# Check the model is on YOUR account before setting it: a model the key cannot
# use returns HTTP 404 ("does not exist or you do not have access to it"), not
# 401. List them with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $KEY"
# NIYAMSETU_RAG_LLM_PROVIDER=groq
# NIYAMSETU_RAG_LLM_MODEL=openai/gpt-oss-120b
# NIYAMSETU_RAG_LLM_API_KEY=put-your-key-here-dot-env-is-git-ignored
# NIYAMSETU_RAG_LLM_BASE_URL=
# NIYAMSETU_RAG_LLM_TEMPERATURE=0.0
# NIYAMSETU_RAG_LLM_MAX_TOKENS=800
# NIYAMSETU_RAG_LLM_TIMEOUT=60

# Retrieval. Dense (semantic) retrieval needs sentence-transformers + torch and
# embeds the corpus on first use; it loads in a background thread, so Ask
# answers from BM25 immediately and upgrades to hybrid when it is ready.
# Set to 0 to stay lexical-only.
# NIYAMSETU_RAG_ENABLE_DENSE=1
# NIYAMSETU_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# NIYAMSETU_RAG_TOP_K=6
# NIYAMSETU_RAG_CANDIDATE_DEPTH=20
# NIYAMSETU_RAG_RRF_K=60
# NIYAMSETU_RAG_CONTEXT_CHARS=12000
